{
  "openapi": "3.1.0",
  "info": {
    "title": "Item Compare API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/compare": {
      "post": {
        "summary": "Compare",
        "description": "Похожесть двух товаров в процентах.",
        "operationId": "compare_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/match": {
      "post": {
        "summary": "Match",
        "description": "Сравнивает товар со списком кандидатов и сортирует их по похожести (поиск дублей).",
        "operationId": "match_v1_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompareRequest": {
        "properties": {
          "item_a": {
            "$ref": "#/components/schemas/Item"
          },
          "item_b": {
            "$ref": "#/components/schemas/Item"
          }
        },
        "type": "object",
        "required": [
          "item_a",
          "item_b"
        ],
        "title": "CompareRequest"
      },
      "CompareResult": {
        "properties": {
          "similarity": {
            "type": "number",
            "title": "Similarity",
            "description": "Итоговая похожесть, 0..100"
          },
          "is_same": {
            "type": "boolean",
            "title": "Is Same",
            "description": "similarity >= порога same_threshold"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentScore"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "similarity",
          "is_same",
          "components"
        ],
        "title": "CompareResult"
      },
      "ComponentScore": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "cosine": {
            "type": "number",
            "title": "Cosine"
          },
          "similarity": {
            "type": "number",
            "title": "Similarity"
          },
          "weight": {
            "type": "number",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "cosine",
          "similarity",
          "weight"
        ],
        "title": "ComponentScore"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "string",
                "pattern": "^data:image/[\\w.+-]+;base64,"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "Ссылка http(s) на картинку или сама картинка как data:image/...;base64,..."
          },
          "attributes": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object",
            "title": "Attributes"
          }
        },
        "type": "object",
        "title": "Item",
        "description": "Товар. Все поля необязательные, но нужна хотя бы картинка или текст.\n\nЛишние поля (price, sku, ...) молча игнорируются, поэтому можно присылать\nобъекты товаров из других сервисов как есть."
      },
      "Kind": {
        "type": "string",
        "enum": [
          "image_image",
          "text_text",
          "image_text"
        ],
        "title": "Kind",
        "description": "Какие части двух товаров сравниваются между собой."
      },
      "Match": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "result": {
            "$ref": "#/components/schemas/CompareResult"
          }
        },
        "type": "object",
        "required": [
          "index",
          "id",
          "result"
        ],
        "title": "Match"
      },
      "MatchRequest": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Item"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Candidates"
          },
          "top_k": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Top K"
          }
        },
        "type": "object",
        "required": [
          "query",
          "candidates"
        ],
        "title": "MatchRequest"
      },
      "MatchResponse": {
        "properties": {
          "matches": {
            "items": {
              "$ref": "#/components/schemas/Match"
            },
            "type": "array",
            "title": "Matches"
          }
        },
        "type": "object",
        "required": [
          "matches"
        ],
        "title": "MatchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
